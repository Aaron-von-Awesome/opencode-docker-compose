{
  "$schema": "https://opencode.ai/config.json",
  // Only enable (local) Docker Model Runner Provider
  "enabled_providers": ["dmr"],
  // Default Agent
  "default_agent": "plan",
  // Automatically Compact to avoid exceeding the context limit
  "compaction": { "auto": true, "prune": true },
  // Docker Model Runner Settings
  "provider": {
    "dmr": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Docker Model Runner",
      "options": {
        "baseURL": "{env:MODEL_URL}",
      },
      "models": {
        //"qwen3-coder-next": {
        //  "name": "qwen3-coder-next",
        //},
        "gpt-oss:20B-F16": {
          "name": "gpt-oss:20B-F16",
        },
      },
    },
  },
}
