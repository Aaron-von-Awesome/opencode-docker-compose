{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "update": "disable",
  "share": "disabled",
  //"lsp": true,
  // Only one provider is ever enabled — the active model is selected at
  // container start via `opencode-run.sh --model <shortname>`, which merges
  // the matching `models/<shortname>.yaml` overlay. The overlay populates
  // ACTIVE_MODEL_URL, ACTIVE_MODEL_NAME, and ACTIVE_MODEL_DISPLAY_NAME so
  // this single provider block adapts to whichever model is bound.
  "enabled_providers": ["active"],
  // Uncomment the line below to disable all of the OpenCode "free" models that use your data for training.
  // "disabled_providers": ["opencode"],
  // Default Agent
  "default_agent": "plan",
  // Small model for lightweight tasks like title generation. Uses the
  // active model by default; point to a cheaper model if available.
  // "small_model": "{env:ACTIVE_MODEL_NAME}",
  // Maximum subagent nesting depth. 1 = primary agents can launch
  // subagents but subagents cannot. 0 = no subagents.
  "subagent_depth": 1,
  // Enable snapshot tracking for undo/revert of file changes.
  "snapshot": true,
  // Automatically compact to avoid exceeding the context limit
  "compaction": { "auto": true },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "opencode", "effect": "deny" }
    ]
  },
  "provider": {
    "active": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "{env:ACTIVE_MODEL_DISPLAY_NAME}",
      "options": {
        "baseURL": "{env:ACTIVE_MODEL_URL}",
      },
      "models": {
        "{env:ACTIVE_MODEL_NAME}": {
          "name": "{env:ACTIVE_MODEL_NAME}",
        },
      },
    },
  },
  "plugins": [
    // "/home/abc/development/skills/ponytail/.opencode/plugins/ponytail.mjs",
    // "opencode-skill-creator",
    // "/home/abc/development/skills/agent-creator/plugin.mjs",
    // "superpowers@git+https://github.com/obra/superpowers.git",
  ],
}
