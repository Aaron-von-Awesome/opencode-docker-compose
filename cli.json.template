{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "dark"
  },
  "mouse": false,
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "title": true,
    "copy": "manual"
  },
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": false,
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "numbers"
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false
  },
  "prompt": {
    "editor": true,
    "paste": "full",
    "image_preview": false
  }
}
